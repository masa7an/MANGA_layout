# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# 仮想環境
venv/
.venv/

# エディタ / OS
.vscode/
.idea/
Thumbs.db
desktop.ini

# Claude Code の設定（許可ルールなど。PC ごとの事情が入るため共有しない）。
# プロジェクトのルールそのものは CLAUDE.md 側に置いて管理下に入れる
.claude/

# Codex の設定も同じ扱い（入口は AGENTS.md）。
# このリポジトリは公開しているので、設定を中に置く前に除外しておく
.codex/

# 作業用の一時ファイル
*.log
tmp/
scratch/

# 動作確認用の使い捨てプロジェクト（実際の原稿はリポジトリの外で扱う）
/data/

# サンプルは project.json だけを管理し、画像・バックアップ・書き出しは含めない
/samples/*/assets/
/samples/*/backup/
/samples/*/export/

# アプリが書き出すもの（本来は %LOCALAPPDATA% に置くが、開発中に混入した場合の保険）
/cache/
/backup/
/export/
*.tmp
